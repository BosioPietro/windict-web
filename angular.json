{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "windict-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "static",
            "polyfills": ["@angular/localize/init"],
            "localize": true
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["en"]
            },
            "development-it": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["it"]
            },
            "development-es": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["es"]
            },
            "development-fr": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["fr"]
            },
            "development-de": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["de"]
            },
            "development-pt": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": ["pt"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "windict-web:build:production"
            },
            "development": {
              "buildTarget": "windict-web:build:development"
            },
            "development-it": {
              "buildTarget": "windict-web:build:development-it"
            },
            "development-es": {
              "buildTarget": "windict-web:build:development-es"
            },
            "development-fr": {
              "buildTarget": "windict-web:build:development-fr"
            },
            "development-de": {
              "buildTarget": "windict-web:build:development-de"
            },
            "development-pt": {
              "buildTarget": "windict-web:build:development-pt"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "windict-web:build",
            "format": "json",
            "outputPath": "src/locale"
          }
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "en",
          "subPath": "en"
        },
        "locales": {
          "it": {
            "translation": "src/locale/messages.it.json",
            "subPath": "it"
          },
          "es": {
            "translation": "src/locale/messages.es.json",
            "subPath": "es"
          },
          "fr": {
            "translation": "src/locale/messages.fr.json",
            "subPath": "fr"
          },
          "de": {
            "translation": "src/locale/messages.de.json",
            "subPath": "de"
          },
          "pt": {
            "translation": "src/locale/messages.pt.json",
            "subPath": "pt"
          }
        }
      }
    }
  }
}
